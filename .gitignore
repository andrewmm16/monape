# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# caleta sourcing (no subir sesión WhatsApp ni descargas locales)
/.caleta-whatsapp/
/scripts/caleta/salida/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# CV de prueba (pueden contener datos personales)
/pruebas/

# Estado local de la CLI de Supabase (incluye secretos del stack local)
/supabase/.temp/
/supabase/.branches/

# robot de portales: sesión del navegador y estado local (sensibles)
/bot/.profile/
/bot/.state/
# registros de procesos lanzados a mano (app, robot y portales ficticios)
/.bot.log
/.fake-portal.log
/.next-start.log
# lector de correo: estado local (hashes de lo procesado)
/correo/.state/
/.build.log
# CV escaneados del banco de OCR: 8 MB derivados de cv-prueba/, reproducibles
# con `npx tsx scripts/generar-cv-escaneado.ts` (la degradación es
# determinista, así que se regeneran idénticos).
/cv-prueba-escaneado/
# CV en .docx del banco de formato, reproducibles con generar-cv-docx.ts
/cv-prueba-docx/
# Salida del lector de CV en lote (caleta:lote-cv): puede contener datos de contacto
/salida/
.next-prod
.prod.log
.build-prod.log
# diagnóstico/artefactos de build y logs de procesos lanzados a mano
/.next-dev-diag/
/.robot.log
# salida generada por el scraper de mercado (datos reproducibles)
/ofertas_mercado.json

# Servidores locales lanzados con scripts/servidores.cmd (PID y registros)
/.servidores/
