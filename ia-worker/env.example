# Worker de IA (npm run ia:worker). Copie este archivo a .env.ia-worker en la raíz del repo
# (está en .gitignore) o defina las variables en el servicio (systemd, Programador de tareas).

# URL pública de la app (la de Vercel en producción), sin barra final.
IA_WORKER_APP_URL=https://reclutamiento.ejemplo.com
# El mismo valor que AI_WORKER_SECRET en el servidor (32 caracteres o más).
IA_WORKER_SECRET=

# Autenticación con Claude (suscripción, sin API de pago). Genere el token en cualquier PC con
# `claude setup-token` (dura un año) y péguelo aquí. Sin él, el CLI usa la sesión iniciada con `claude`.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Opcionales ---
# IA_WORKER_CLI_PATH=claude          # ruta completa si `claude` no está en el PATH
# IA_WORKER_POLL_SECONDS=10          # espera entre consultas cuando la cola está vacía (2-300)
# IA_WORKER_TIMEOUT_SECONDS=300      # tiempo máximo por CV (30-480; la reserva de un trabajo dura 10 min)
# IA_WORKER_CONCURRENCY=1            # CV en paralelo (1-4); más paralelismo agota antes la ventana del plan
# IA_WORKER_MODEL=claude-sonnet-5-5  # fuerza un modelo; por defecto el AI_MODEL del servidor
