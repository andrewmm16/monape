# =============================================================================
# Plataforma de reclutamiento · Interruptivo Perú
# Copie este archivo a `.env.local` (desarrollo) y complete los valores.
# NUNCA suba archivos .env con valores reales al repositorio.
#
# PÚBLICAS  = prefijo NEXT_PUBLIC_: pueden llegar al navegador.
# SERVIDOR  = sin prefijo: solo existen en el servidor (Vercel / Node).
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# [SERVIDOR] URL pública de la aplicación (enlaces de recuperación de contraseña
# e invitaciones). Debe figurar en Auth > URL Configuration de Supabase.
APP_URL=http://localhost:3000
# [SERVIDOR] development | test | staging | production
APP_ENV=development

# --- Supabase ----------------------------------------------------------------
# [PÚBLICA] Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# [PÚBLICA] Clave "publishable" (sb_publishable_...). En proyectos con claves
# heredadas puede usarse la clave "anon". Está protegida por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [SERVIDOR · SECRETA] Clave "secret" (sb_secret_...) o la heredada
# "service_role". Omite RLS. Necesaria para: subir y firmar descargas de CV
# (los usuarios no acceden al bucket directamente), invitar y bloquear
# usuarios (src/lib/supabase/admin.ts), el script de datos ficticios y firmar
# la cookie de cierre por inactividad (sin ella no se puede iniciar sesión).
SUPABASE_SECRET_KEY=

# --- Inteligencia artificial (deshabilitada por defecto) --------------------
# [SERVIDOR] none | anthropic
AI_PROVIDER=none
# [SERVIDOR · SECRETA] Clave del proveedor de IA.
AI_API_KEY=
# [SERVIDOR] Modelo del proveedor.
AI_MODEL=claude-opus-5-5
# [SERVIDOR] Debe ser "true" solo cuando la empresa haya aprobado por escrito
# el proveedor, sus condiciones y el tratamiento de datos (incluida la
# transferencia internacional). Mientras sea "false" no se envía ningún CV
# a servicios externos.
AI_EXTERNAL_PROCESSING_APPROVED=false
# [SERVIDOR] Máximo de evaluaciones con IA por día (control de costos).
AI_MAX_EVALUATIONS_PER_DAY=50
# [SERVIDOR] Máximo de caracteres del CV enviados al modelo.
AI_MAX_INPUT_CHARS=30000

# --- Páginas públicas de vacantes (2.9) ------------------------------------
# [SERVIDOR] "true" enciende /empleos, el feed, robots.txt y sitemap.xml.
# Apagada (por defecto): /empleos responde 404, robots.txt bloquea todo y el
# sitemap queda vacío. Requiere SUPABASE_SECRET_KEY.
PUBLIC_JOBS_ENABLED=false
# [SERVIDOR] URL canónica pública, p. ej. https://empleos.su-dominio.pe.
# Obligatoria si está encendida.
PUBLIC_SITE_URL=
# [SERVIDOR] Nombre de la empresa en la página, Google y el feed.
# Obligatorio si está encendida.
PUBLIC_COMPANY_NAME=
# [SERVIDOR] Opcionales: sitio web y logo (URL absoluta) de la empresa.
PUBLIC_COMPANY_WEBSITE=
PUBLIC_COMPANY_LOGO_URL=

# --- Recepción de Talent Apply (2.10) ----------------------------------------
# [SERVIDOR] "true" enciende la recepción de postulaciones de Talent.com y su
# feed con <talent-apply-data>. Apagada (por defecto): las rutas
# /api/integraciones/talent/* responden 404. Encendida exige SUPABASE_SECRET_KEY,
# PUBLIC_SITE_URL, PUBLIC_COMPANY_NAME y los dos secretos de abajo.
TALENT_APPLY_ENABLED=false
# [SERVIDOR · SECRETA] Mínimo 32 caracteres. Firma el token de la URL de
# postulación de cada vacante (HMAC-SHA256). Cambiarla invalida las URL ya
# entregadas a Talent.com. Genere una con: openssl rand -base64 48
TALENT_APPLY_SECRET=
# [SERVIDOR · SECRETA] Mínimo 32 caracteres. Token de la URL del feed
# /api/integraciones/talent/feed/<token> que se entrega a Talent.com.
TALENT_FEED_TOKEN=

# --- Formulario público de postulación (2.2) ------------------------------------
# [SERVIDOR] "true" ofrece el formulario de postulación en /empleos/<vacante>
# (solo si además hay un aviso de privacidad vigente y la vacante está abierta).
# Apagado (por defecto): se mantiene el botón deshabilitado. Encendido exige
# PUBLIC_JOBS_ENABLED=true, SUPABASE_SECRET_KEY e INTAKE_HASH_SECRET.
PUBLIC_APPLY_ENABLED=false
# [SERVIDOR · SECRETA] Mínimo 32 caracteres. Firma los desafíos anti-abuso del
# formulario y deriva (HMAC) el identificador de límite a partir de la IP: la IP
# nunca se guarda. Cambiarla invalida los desafíos en curso. Genere una con:
# openssl rand -base64 48
INTAKE_HASH_SECRET=

# --- Correo (Etapa 3: aún no utilizado por la aplicación) -------------------
# [SERVIDOR · SECRETA]
RESEND_API_KEY=
# [SERVIDOR] Remitente verificado en Resend, p. ej. "RRHH <rrhh@dominio-verificado>"
EMAIL_FROM=
# [SERVIDOR] test (no envía) | live
EMAIL_DELIVERY_MODE=test

# --- Solo para scripts de desarrollo ----------------------------------------
# [SERVIDOR] Contraseña de los usuarios ficticios creados por `npm run db:seed`.
# Si se deja vacía, el script genera una aleatoria y la muestra una sola vez.
SEED_USER_PASSWORD=
# [SERVIDOR] El script de datos ficticios se niega a ejecutarse contra un
# proyecto remoto salvo que esta variable sea "true" (solo entornos de prueba).
SEED_ALLOW_REMOTE=false
