# Copiar a .env.correo en la raíz del proyecto (ignorado por git). No subir valores reales.
# La app y el secreto son los mismos que usa el robot (bot/env.example).
BOT_API_URL=http://localhost:3000
PORTAL_BOT_SECRET=
# Buzón de empleo (IMAP). Use una contraseña de APLICACIÓN, nunca la contraseña personal.
MAIL_IMAP_HOST=
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
# MAIL_MAILBOX=INBOX
# MAIL_POLL_SECONDS=300
# MAIL_STATE_FILE=correo/.state/procesados.json
# MAIL_REQUIRE_AUTH=true   # exige dkim=pass o spf=pass junto con dmarc=pass; false solo para pruebas
# MAIL_FOLDER=muestras-correo   # lee archivos .eml de esta carpeta en vez del buzón (equivale a --folder)
# MAIL_ENABLE_EXAMPLE=1    # activa la plantilla ficticia "ejemplo-ficticio" (solo pruebas)
