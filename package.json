{
  "name": "interruptivo-reclutamiento",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:bot": "vitest run --project bot",
    "bot": "tsx --env-file-if-exists=.env.bot bot/src/index.ts",
    "ia:worker": "tsx --env-file-if-exists=.env.ia-worker ia-worker/src/index.ts",
    "correo": "tsx --env-file-if-exists=.env.correo correo/src/index.ts",
    "mercado": "tsx mercado/src/index.ts",
    "bot:login": "tsx --env-file-if-exists=.env.bot bot/src/login.ts",
    "bot:whatsapp-login": "tsx --env-file-if-exists=.env.bot bot/src/whatsapp-login.ts",
    "bot:fake-portal": "tsx bot/src/fake-portal/main.ts",
    "bot:entrenar": "tsx --env-file-if-exists=.env.bot bot/src/repair/entrenar.ts",
    "bot:training-report": "tsx --env-file-if-exists=.env.bot bot/src/training-report.ts",
    "bot:medir-reparacion": "tsx --env-file-if-exists=.env.bot bot/src/repair/medir.ts",
    "bot:demo-queue": "tsx --env-file-if-exists=.env.local scripts/demo-robot-queue.ts",
    "bot:demo-captcha": "tsx scripts/demo-captcha.ts",
    "bot:desafios-report": "tsx --env-file-if-exists=.env.bot bot/src/desafios-report.ts",
    "test:e2e": "playwright test",
    "test:secrets": "node scripts/check-client-bundle.mjs",
    "db:types": "tsx scripts/gen-db-types.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "db:seed:caleta": "tsx --env-file-if-exists=.env.local scripts/seed-caleta-vacantes.ts",
    "db:seed:caleta:prospects": "tsx --env-file-if-exists=.env.local scripts/seed-caleta-prospects.ts",
    "caleta:lote-cv": "tsx scripts/caleta/cosechar-lote.ts",
    "caleta:recolectar": "node scripts/caleta/recolector-caleta.mjs",
    "caleta:importar": "tsx --env-file-if-exists=.env.local scripts/importar-prospectos-enriquecidos.ts",
    "caleta:buscar": "node scripts/caleta/buscar-cvs-google.mjs",
    "caleta:procesar": "node --env-file-if-exists=.env.local scripts/caleta/procesar-cvs.mjs",
    "caleta:puntuar": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/caleta/puntuar-prospectos.ts",
    "caleta:whatsapp": "node --env-file-if-exists=.env.local scripts/caleta/enviar-whatsapp-caleta.mjs",
    "caleta:diario": "node --env-file-if-exists=.env.local scripts/caleta/caleta-diario.mjs",
    "medir:motor": "tsx scripts/medir-motor/main.ts",
    "calibrar:motor": "tsx scripts/medir-motor/calibracion.ts",
    "gold:motor": "tsx scripts/medir-motor/gold.ts",
    "medir:motor:adversario": "tsx scripts/medir-motor/adversario.ts",
    "medir:ia": "tsx --env-file-if-exists=.env.ia-worker scripts/medir-motor/ia.ts",
    "vigilar:ia": "tsx --env-file-if-exists=.env.ia-worker scripts/vigilar-ia.ts",
    "informe:ia": "tsx --env-file-if-exists=.env.local scripts/medir-motor/discrepancias.ts",
    "medir:motor:legitimo": "tsx scripts/medir-motor/legitimo.ts",
    "medir:motor:escaneado": "tsx --conditions=react-server scripts/medir-motor/escaneado.ts",
    "medir:motor:docx": "tsx scripts/medir-motor/docx.ts",
    "auditar:vacantes": "tsx scripts/medir-motor/auditar.ts",
    "verificar:extraccion": "tsx scripts/verificar-extraccion-oculta.ts",
    "verificar:motor": "npm run medir:motor && npm run medir:motor:adversario && npm run medir:motor:legitimo && npm run medir:motor:docx",
    "verificar:motor:completo": "npm run verificar:motor && npm run medir:motor:escaneado -- --desde oficina && npm run medir:motor:escaneado -- --desde foto"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@hookform/resolvers": "^5.9.2",
    "@napi-rs/canvas": "1.0.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fflate": "^0.8.3",
    "imapflow": "^2.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "patchright": "^1.64.3",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
