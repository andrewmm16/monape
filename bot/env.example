# Copiar a .env.bot en la raíz del proyecto (ignorado por git). No subir valores reales.
BOT_API_URL=http://localhost:3000
PORTAL_BOT_SECRET=
# Un adaptador, una lista separada por comas, o demo (= los 5 portales ficticios):
#   fake | fake-linkedin | fake-bumeran | fake-trabajos-diarios | fake-indeed | fake-computrabajo | demo
BOT_ADAPTER=fake
BOT_FAKE_PORTAL_URL=http://127.0.0.1:4010
# BOT_HEADLESS=false
# BOT_POLL_SECONDS=600
# BOT_PAUSE_MS=2000
# BOT_MAX_JOBS_PER_CYCLE=10
# BOT_SLOWMO_MS=0
# BOT_HEALTH_CHECK_HOURS=24
# BOT_NOTIFY_PHONE=51999999999   # avisos por WhatsApp al responsable (solo dígitos, con código de país)
# BOT_WHATSAPP_DIR=bot/.state/whatsapp
# BOT_INCIDENTS_DIR=bot/.state/incidentes
# BOT_RESUME_CHECK_MINUTES=10   # reintenta solo la prueba de estructura de un portal detenido por pagina_cambio y lo reanuda (1-1440; 0 = desactivado)
# --- Reparacion asistida por IA (opcional): sin ANTHROPIC_API_KEY queda desactivada y el robot funciona como siempre ---
# ANTHROPIC_API_KEY=               # clave de la API de Anthropic (solo en .env.bot, nunca en git). Hacia el modelo solo sale el esquema saneado de la pantalla y el mensaje saneado
# BOT_REPAIR_MODEL=claude-sonnet-5-5   # ID exacto del modelo, sin sufijo de fecha
# BOT_REPAIR_MAX_PER_DAY=10        # maximo de consultas al modelo por dia (0-1000; 0 = apagado)
# BOT_REPAIR_VERIFY_MINUTES=30     # si la prueba de estructura falla dentro de este plazo tras aplicar una propuesta, se revierte sola (1-1440)
# BOT_REPAIR_MAX_ATTEMPTS=3        # intentos por incidente: cada propuesta se prueba antes de enviarla y, si falla, se pide una correccion (1-5)
# BOT_PROPOSALS_DIR=bot/.state/propuestas
# BOT_SELECTORS_FILE=bot/.state/selectores.json    # selectores aprobados por una persona
# BOT_TOLERANCES_FILE=bot/.state/tolerancias.json  # veces que el robot uso un selector alternativo
# --- Solo para el servidor de portales ficticios (npm run bot:fake-portal -- --entrenar); no son del robot ---
# BOT_FAKE_AUTO_RESTORE=1          # 0 = un cambio estructural dura hasta resolverlo (igual que --sin-auto)
# BOT_FAKE_RESTORE_GRACE_MINUTES=3 # margen entre que el robot detecta un cambio y se restablece el portal
# BOT_FAKE_MAX_LIFE_MINUTES=60     # vida maxima de un cambio estructural sin detectar
# BOT_FAKE_REPORT_MINUTES=15       # cada cuanto se regenera bot/.state/informe-entrenamiento.md
